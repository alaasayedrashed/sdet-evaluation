<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Small, deliberate rule set. Formatting (indentation, line length, braces) is owned by
    google-java-format via Spotless, so it is not repeated here. Checked:
      - naming conventions
      - unused and star imports
      - empty catch blocks
      - no System.out / System.err (use the SLF4J logger)
      - no Thread.sleep (use explicit waits)
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Naming conventions (Checkstyle defaults: camelCase members, UPPER_CASE constants) -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="CatchParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="StaticVariableName"/>
        <module name="ConstantName"/>
        <module name="RecordComponentName"/>
        <module name="PatternVariableName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>

        <!-- A swallowed exception must at least be explained by a comment or a log line -->
        <module name="EmptyCatchBlock"/>

        <!-- Logging goes through SLF4J -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="noSystemOutErr"/>
            <property name="format" value="System\.(out|err)\b"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Use the SLF4J logger instead of System.out / System.err."/>
        </module>

        <!-- Waits must be explicit (WebDriverWait / FluentWait / Playwright auto-waiting) -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="noThreadSleep"/>
            <property name="format" value="Thread\.sleep\s*\("/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Thread.sleep is not allowed; use an explicit wait."/>
        </module>
    </module>
</module>
